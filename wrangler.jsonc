{
  "name": "outlet",
  "main": "_worker.js",
  "compatibility_date": "2026-09-12",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "migrations": [\n    { "tag": "v1", "new_sqlite_classes": ["Presence"] }\n  ],\n  "durable_objects": {\n    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "Presence"
      }
    ]
  },
  
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
