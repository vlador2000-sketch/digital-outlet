{
  "name": "outlet",
  "main": "_worker.js",
  "compatibility_date": "2026-09-12",
  "exports": {
    "Presence": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "observability": {
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      }
    },
    "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": false
  }
}
