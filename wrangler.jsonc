{
  "name": "outlet",
  "main": "_worker.js",
  "compatibility_date": "2026-09-12",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "Presence"
      }
    ]
  },
  "exports": {
    "Presence": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
